{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "outDir": "gen",
    "types": ["node"]
  },
  "include": ["srv/**/*.ts", "srv/**/*.cts"],
  "exclude": ["node_modules", "app", "gen", "db"]
}
